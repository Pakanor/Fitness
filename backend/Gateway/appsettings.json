{
  "ReverseProxy": {
    "Routes": {
      "auth-api": {
        "Cluster": "auth-api",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "calorie-calculator": {
        "Cluster": "backendlogic-api",
        "Match": {
          "Path": "/api/caloriecalculator/{**catch-all}"
        }
      },
      "products-operation": {
        "Cluster": "backendlogic-api",
        "Match": {
          "Path": "/api/productsoperation/{**catch-all}"
        }
      },
      "exercise-db": {
        "Cluster": "exercise-api",
        "Match": {
          "Path": "/api/exercisedb/{**catch-all}"
        }
      },
      "records": {
        "Cluster": "exercise-api",
        "Match": {
          "Path": "/api/records/{**catch-all}"
        }
      },
      "templates": {
        "Cluster": "exercise-api",
        "Match": {
          "Path": "/api/templates/{**catch-all}"
        }
      },
      "workouts": {
        "Cluster": "exercise-api",
        "Match": {
          "Path": "/api/workouts/{**catch-all}"
        }
      },
      "workout-start": {
        "Cluster": "exercise-api",
        "Match": {
          "Path": "/api/workout-start/{**catch-all}"
        }
      },
      "workout-status": {
        "Cluster": "exercise-api",
        "Match": {
          "Path": "/api/workout-status/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-api": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5010/"
          }
        }
      },
      "backendlogic-api": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5142/"
          }
        }
      },
      "exercise-api": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5185/"
          }
        }
      }
    }
  }
}
