# Copy to .env and fill in before running: docker compose up --build
# .env is gitignored and must never be committed.

# RapidAPI key used by ExerciseAPI when importing exercises/gifs (https://rapidapi.com)
RAPIDAPI_KEY=

# Postgres password the APIs authenticate with (DB_PASSWORD).
# Used by AuthAPI, ExerciseAPI and BackendLogicApi when they start —
# startup fails fast if it is missing.
DB_PASSWORD=

# Password for the auth / exercise / products Postgres containers.
# Keep the same value as DB_PASSWORD.
POSTGRES_PASSWORD=
